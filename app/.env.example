# Web. Baked into the client at `next dev` / `next build` / desktop export.
NEXT_PUBLIC_WS_URL=ws://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Desktop shell only. Set on the Tauri process to override the gateway at
# runtime without rebuilding. See apps/desktop/.env.example. No secrets.
# WS_URL=ws://localhost:8787

# Match-server (RedQueen V1)
MATCH_SERVER_PORT=8787
