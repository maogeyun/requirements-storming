# Runtime override for the match-server WebSocket.
# Launch the desktop process with this set. Unset keeps the web default
# (NEXT_PUBLIC_WS_URL at dev/export time, otherwise ws://localhost:8787).
# Do not put secrets in this file or in the repo.
# WS_URL=ws://localhost:8787

# Steam AppID for `dev:steam` / `build:steam`. Same value as steam_appid.txt.
# 480 is Spacewar and only for local init. Do not commit a shipping AppID.
# STEAM_APP_ID=480
